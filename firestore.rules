rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno() {
      return request.auth != null && request.auth.uid == "vKixdwAJz9MfApZV81FPOiPybFr2";
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if esDueno();
    }

    match /pedidos/{pedidoId} {
      // El cliente puede crear un pedido sin iniciar sesión.
      // Solo el dueño puede leer, cambiar estado o eliminar pedidos.
      allow create: if request.resource.data.tipo == "tienda"
        && request.resource.data.estado == "nuevo"
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 1
        && request.resource.data.cantidad <= 99
        && request.resource.data.cliente is map
        && request.resource.data.cliente.nombre is string
        && request.resource.data.cliente.nombre.size() >= 2
        && request.resource.data.cliente.telefono is string
        && request.resource.data.cliente.telefono.size() >= 7
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 99
        && request.resource.data.total is number;
      allow read, update, delete: if esDueno();
    }
  }
}
