rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esDueno() {
      return request.auth != null
        && request.auth.uid == "vKixdwAJz9MfApZV81FPOiPybFr2";
    }

    match /productos/{productoId} {
      allow read: if true;
      allow create, update, delete: if esDueno();
    }

    match /pedidos/{pedidoId} {
      // El cliente puede enviar el pedido sin iniciar sesión.
      // El dueño es el único que puede leerlo, modificar su estado o eliminarlo.
      allow create: if request.resource.data.tipo == "personalizado"
        && request.resource.data.estado == "nuevo"
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 1
        && request.resource.data.cantidad <= 20
        && request.resource.data.cliente is map
        && request.resource.data.cliente.nombre is string
        && request.resource.data.cliente.telefono is string
        && request.resource.data.fechaEntrega is string
        && request.resource.data.camisas is list
        && request.resource.data.camisas.size() == request.resource.data.cantidad;
      allow read, update, delete: if esDueno();
    }
  }
}
